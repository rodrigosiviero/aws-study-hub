---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseDeck from '../../../components/CourseDeck.astro';
const base = import.meta.env.BASE_URL;
const slides = [{"eyebrow": "Course map", "title": "Secure the identity-to-data path", "body": "<div class=\"course-four-grid\"><div><b>Authenticate</b><span>Who is calling?</span></div><div><b>Authorize</b><span>What can they do?</span></div><div><b>Protect</b><span>Encrypt and mask</span></div><div><b>Audit</b><span>Prove what happened</span></div></div>", "context": "Domain 4 layers controls. No single service replaces IAM, KMS, Lake Formation, and logging."}, {"eyebrow": "Identity", "title": "Prefer temporary roles over long-lived keys", "body": "<ul class=\"course-bullets two-up\"><li>IAM roles provide temporary credentials to Lambda, Glue, EMR, and EC2.</li><li>IAM Identity Center provides workforce SSO.</li><li>Secrets Manager stores and rotates database credentials.</li><li>Parameter Store stores configuration but has no native rotation.</li></ul>", "context": "The exam usually favors roles for workloads and Secrets Manager for rotating database credentials."}, {"eyebrow": "Network", "title": "Security groups restrict network reachability", "body": "<ul class=\"course-bullets\"><li>Security groups are stateful ENI firewalls: protocol, port, and CIDR or source SG.</li><li>NACLs are stateless subnet controls.</li><li>Allow Glue/Lambda to reach JDBC databases through least-privilege SG rules.</li></ul>", "context": "Network reachability is separate from IAM authorization and encryption."}, {"eyebrow": "IAM", "title": "Least privilege is a policy design problem", "body": "<ul class=\"course-bullets two-up\"><li>Scope Action, Resource, and Condition; explicit deny wins.</li><li>Use customer-managed policies for reusable controls.</li><li>Use Access Analyzer and CloudTrail activity to refine policies.</li><li>Use permissions boundaries and SCPs for guardrails.</li></ul>", "context": "A successful authentication does not mean the role has permission to read the data."}, {"eyebrow": "Lake Formation", "title": "Fine-grained lake authorization", "body": "<div class=\"course-flow\"><span>IAM principal</span><b>→</b><span class=\"aws-box\">Lake Formation grants</span><b>→</b><span>Catalog table, column, row</span><b>→</b><span>S3 data</span></div><ul class=\"course-bullets\"><li>Grant database, table, column, row, and data-location permissions.</li><li>LF-Tags provide attribute-based access at scale.</li><li>Athena, EMR, Glue, and Redshift can consume governed catalog data.</li></ul>", "context": "Lake Formation complements IAM and centrally governs data lake access."}, {"eyebrow": "Database access", "title": "Authorization depends on the engine", "body": "<table class=\"course-table\"><tr><th>Store</th><th>Control</th></tr><tr><td>Redshift</td><td>Roles, schema/table/column grants, RLS</td></tr><tr><td>Aurora/RDS</td><td>Native users/roles or IAM DB auth</td></tr><tr><td>DynamoDB</td><td>IAM policies and condition keys</td></tr></table>", "context": "Fine-grained access may belong in Lake Formation, a database role, or IAM depending on the data store."}, {"eyebrow": "KMS", "title": "Encryption at rest requires key access", "body": "<ul class=\"course-bullets two-up\"><li>AWS managed keys are simple; customer-managed keys provide policy control, rotation, grants, and aliases.</li><li>SSE-KMS protects S3; KMS also protects Redshift, RDS, DynamoDB, and Secrets Manager.</li><li>Envelope encryption uses a data key for bulk data.</li><li>Encryption context adds authenticated context.</li></ul>", "context": "KMS permissions and the resource policy both matter, especially across accounts."}, {"eyebrow": "Transit and masking", "title": "Protect data before it is consumed", "body": "<ul class=\"course-bullets\"><li>Enforce TLS with service configuration and aws:SecureTransport policies.</li><li>Client-side encryption protects data before it reaches AWS.</li><li>Mask, tokenize, or pseudonymize PII for different re-identification needs.</li><li>DataBrew and Lake Formation support masking/filtering workflows.</li></ul>", "context": "Encryption hides data from unauthorized readers; masking limits what authorized analysts can see."}, {"eyebrow": "Sensitive data", "title": "Macie discovers; it does not govern", "body": "<ul class=\"course-bullets two-up\"><li>Macie identifies and classifies sensitive data in S3.</li><li>Use findings to trigger tagging, masking, restriction, or remediation.</li><li>Use Lake Formation/IAM/KMS to enforce the resulting control.</li></ul>", "context": "Discovery, enforcement, and audit are different capabilities."}, {"eyebrow": "Audit", "title": "Build evidence with CloudTrail and CloudWatch", "body": "<ul class=\"course-bullets\"><li>CloudTrail management events: AWS control-plane activity.</li><li>CloudTrail data events: S3 objects, Lambda, DynamoDB data access.</li><li>CloudWatch Logs: application and service runtime logs; retention, filters, subscriptions.</li><li>Organization and multi-Region trails centralize audit evidence.</li></ul>", "context": "Audit questions often require long-term, immutable, multi-account evidence: use trails delivered to S3."}, {"eyebrow": "Governance", "title": "Classify, share, and retain responsibly", "body": "<ul class=\"course-bullets two-up\"><li>SageMaker Catalog adds ownership, glossary, projects, subscriptions, and data products.</li><li>Lake Formation shares governed data across accounts.</li><li>Retention and deletion must satisfy legal requirements; S3 lifecycle and Object Lock address different needs.</li><li>Data lineage connects source, transformation, and consumer context.</li></ul>", "context": "Governance is the business layer around technical metadata, permissions, privacy, and lifecycle."}, {"eyebrow": "Exam drill", "title": "Domain 4 active recall", "body": "<ol class=\"course-questions\"><li>Need automatic RDS credential rotation?<details><summary>Answer</summary>Secrets Manager.</details></li><li>Need column and row filtering on a lake table?<details><summary>Answer</summary>Lake Formation.</details></li><li>Need discover PII in S3?<details><summary>Answer</summary>Amazon Macie.</details></li></ol>", "context": "State whether the question asks for authentication, authorization, encryption, discovery, or audit."}, {"eyebrow": "Final review", "title": "Domain 4 readiness checklist", "body": "<ul class=\"checklist\"><li>Use roles, least-privilege policies, and database/Lake Formation grants correctly.</li><li>Distinguish encryption, masking, PII discovery, and audit logging.</li><li>Apply governance across accounts, lifecycle, sharing, and lineage.</li></ul>", "context": "Security answers are layered: choose all required controls, but do not add unrelated operational complexity."}];
const deepDives = [['Authentication', 'Employees use IAM Identity Center|AWS workloads use IAM roles|Database credential rotation uses Secrets Manager'], ['Least privilege', 'Scope Action and Resource narrowly|Use tag, MFA, IP, and TLS conditions|SCPs and boundaries provide guardrails'], ['Cross-account encryption', 'Resource policy shares the data resource|IAM role authorizes the consumer|KMS policy or grant permits decryption'], ['Privacy transformations', 'Masking hides values|Tokenization is reversible through a vault|Pseudonymization preserves linkage'], ['Data in transit', 'SSE-KMS protects at rest|TLS protects in transit|Client-side encryption protects before upload'], ['Audit evidence', 'CloudTrail management events record control-plane activity|Data events record object/data access|CloudWatch Logs record runtime behavior'], ['Governance', 'SageMaker Catalog adds ownership and subscriptions|Lake Formation grants and LF-Tags govern access|Lineage connects producer and consumer'], ['Network layer', 'Security groups are stateful ENI firewalls|NACLs are stateless subnet controls|JDBC pipelines allow only required ports and SGs'], ['Exam traps', 'Macie discovers PII; other controls enforce protection|RDS rotation means Secrets Manager|Row and column filters mean Lake Formation'], ['Coverage review', 'Authenticate, authorize, encrypt/mask, audit, govern|Distinguish IAM, KMS, Macie, Lake Formation, CloudTrail, Config']].map(([title, text]) => ({ eyebrow: 'Deep dive', title, body: '<ul class="course-bullets">' + text.split('|').map(item => '<li>' + item + '</li>').join('') + '</ul>', context: 'Security answers are layered: select every required control, but avoid unrelated operational complexity.' }));
slides.push(...deepDives);
---
<BaseLayout title="Data Security and Governance Course" activeSlug="courses"><CourseDeck title="Data Security and Governance" weight="Domain 4 · 18%" slides={slides} back={`${base}/courses/dea-c01/`} /></BaseLayout>
