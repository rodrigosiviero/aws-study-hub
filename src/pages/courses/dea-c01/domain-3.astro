---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseDeck from '../../../components/CourseDeck.astro';
const base = import.meta.env.BASE_URL;
const slides = [{"eyebrow": "Course map", "title": "Operate data pipelines reliably", "body": "<div class=\"course-four-grid\"><div><b>Automate</b><span>Orchestrate and schedule</span></div><div><b>Analyze</b><span>Query and visualize</span></div><div><b>Monitor</b><span>Logs, metrics, alarms</span></div><div><b>Quality</b><span>Rules and remediation</span></div></div>", "context": "Domain 3 is where built pipelines become reliable, observable data products."}, {"eyebrow": "Orchestration", "title": "Choose Step Functions or MWAA", "body": "<table class=\"course-table\"><tr><th>Requirement</th><th>Service</th></tr><tr><td>Serverless state machine, visual retry/catch</td><td>Step Functions</td></tr><tr><td>Complex Python DAGs, backfills, Airflow operators</td><td>MWAA</td></tr><tr><td>Cron schedules</td><td>EventBridge Scheduler</td></tr></table>", "context": "Orchestration coordinates work; EventBridge routes events; Scheduler creates timed invocations."}, {"eyebrow": "Automation", "title": "Lambda is for short event-driven work", "body": "<ul class=\"course-bullets two-up\"><li>Trigger from S3, SQS, EventBridge, Streams, Kinesis, or API Gateway.</li><li>Use for notifications, manifests, cleanup, and lightweight validation.</li><li>Use Glue or EMR for large distributed transformations.</li><li>Use retries, DLQs, destinations, and idempotency for failures.</li></ul>", "context": "A large ETL job is not made better by forcing it into Lambda."}, {"eyebrow": "Query", "title": "Match the engine to the analysis", "body": "<div class=\"course-two-col\"><div class=\"course-card\"><h3>Athena</h3><p>Serverless SQL on S3; pay per data scanned; partition and use Parquet.</p></div><div class=\"course-card\"><h3>Redshift</h3><p>Warehouse SQL, joins and aggregates at scale; provisioned or serverless.</p></div></div>", "context": "Athena is usually the low-operations answer for ad hoc S3 analysis."}, {"eyebrow": "Visualization", "title": "From dataset to decision", "body": "<ul class=\"course-bullets\"><li>QuickSight provides managed dashboards, embedded analytics, and ML insights.</li><li>DataBrew profiles distributions, outliers, and transformations visually.</li><li>Athena notebooks provide serverless Spark exploration.</li></ul>", "context": "The service for BI dashboards is QuickSight, not Athena or Glue."}, {"eyebrow": "SQL", "title": "Use SQL constructs that fit the question", "body": "<ul class=\"course-bullets two-up\"><li>CTAS creates a table from query results.</li><li>Window functions compute running totals and rolling averages.</li><li>GROUPING SETS, CUBE, and ROLLUP create multiple aggregation levels.</li><li>Partition pruning and predicate pushdown reduce cost and time.</li></ul>", "context": "Query cost is often improved by changing data layout and filters before increasing compute."}, {"eyebrow": "Observability", "title": "CloudWatch turns symptoms into signals", "body": "<div class=\"course-four-grid\"><div><b>Logs</b><span>Application records</span></div><div><b>Metrics</b><span>Numeric health signals</span></div><div><b>Alarms</b><span>Threshold response</span></div><div><b>Insights</b><span>Ad hoc log query</span></div></div>", "context": "CloudWatch observes runtime behavior; CloudTrail answers who called which AWS API."}, {"eyebrow": "Audit", "title": "CloudTrail records AWS activity", "body": "<ul class=\"course-bullets\"><li>Management events record control-plane API activity.</li><li>Data events cover S3 objects, Lambda, and DynamoDB item activity.</li><li>Trails deliver long-term evidence to S3; organization trails cover accounts.</li></ul>", "context": "Do not confuse CloudTrail event history with application logging."}, {"eyebrow": "Troubleshooting", "title": "Read service-specific symptoms", "body": "<table class=\"course-table\"><tr><th>Service</th><th>Signal</th></tr><tr><td>Glue/EMR</td><td>Spark UI, executor logs, skew, shuffle</td></tr><tr><td>Redshift</td><td>STL/SVL tables, WLM queues</td></tr><tr><td>Kinesis</td><td>IteratorAge, throughput exceeded</td></tr><tr><td>DynamoDB</td><td>ThrottledRequests, hot key</td></tr></table>", "context": "The best remediation is tied to the metric. Do not scale blindly."}, {"eyebrow": "Quality", "title": "Define assertions before publishing", "body": "<ul class=\"course-bullets two-up\"><li>Glue Data Quality: completeness, uniqueness, primary-key, custom DQDL.</li><li>DataBrew rules and profiles expose invalid patterns.</li><li>Freshness, row count, distribution, and referential checks catch different failures.</li><li>Fail, quarantine, retry, or alert according to severity.</li></ul>", "context": "Quality is measurable expectations, not a manual spot check."}, {"eyebrow": "Skew", "title": "Prevent one partition from doing all the work", "body": "<ul class=\"course-bullets\"><li>Detect with Spark UI partition sizes or Redshift slice skew.</li><li>Salt a hot key, repartition, filter before join, or broadcast a small dimension.</li><li>Choose a Redshift DISTKEY that distributes rows evenly.</li></ul>", "context": "Skew causes a long tail: most workers finish while one worker remains overloaded."}, {"eyebrow": "Exam drill", "title": "Domain 3 active recall", "body": "<ol class=\"course-questions\"><li>Need retries and visual execution history?<details><summary>Answer</summary>Step Functions.</details></li><li>Need a scheduled one-time or cron invocation?<details><summary>Answer</summary>EventBridge Scheduler.</details></li><li>Need object-level AWS API audit?<details><summary>Answer</summary>CloudTrail data events.</details></li></ol>", "context": "Name the exact requirement before naming the service."}, {"eyebrow": "Final review", "title": "Domain 3 readiness checklist", "body": "<ul class=\"checklist\"><li>Distinguish scheduling, routing, orchestration, processing, and monitoring.</li><li>Use service-specific metrics to diagnose performance.</li><li>Build quality rules and failure paths into production pipelines.</li></ul>", "context": "Operational excellence means detecting, explaining, and recovering from failures quickly."}];
const deepDives = [['SDK automation', 'Use boto3 with IAM roles|Use waiters for async Glue, EMR, and DMS calls|Pass run IDs and parameters through workflows'], ['Data preparation', 'DataBrew profiles nulls and outliers|Recipes make transformations repeatable|Sample large datasets before full scans'], ['Serverless trade-offs', 'Serverless fits spiky and ad hoc work|Provisioned fits steady latency-sensitive work|Control, cost, and startup time are trade-offs'], ['Log analytics', 'Logs Insights queries CloudWatch directly|Athena queries archived S3 logs|OpenSearch provides full-text search and dashboards'], ['Actionable alerts', 'Metric filters create metrics from logs|Alarms notify SNS or trigger remediation|Anomaly detection handles changing baselines'], ['Recovery', 'Step Functions Retry/Catch controls failures|DLQs preserve failed messages|Idempotency and checkpoints prevent duplicates'], ['Sampling', 'Random and stratified samples investigate quality|Reservoir samples suit streams|Spark sample and TABLESAMPLE reduce cost'], ['Quality SLOs', 'Check completeness, uniqueness, keys, and row counts|Measure freshness|Quarantine or fail violations'], ['Exam traps', 'Airflow backfills mean MWAA|Visual retry workflow means Step Functions|Object API audit means CloudTrail data events'], ['Coverage review', 'Automate, analyze, monitor, troubleshoot, ensure quality|Read metrics before scaling']].map(([title, text]) => ({ eyebrow: 'Deep dive', title, body: '<ul class="course-bullets">' + text.split('|').map(item => '<li>' + item + '</li>').join('') + '</ul>', context: 'Select the managed operational control that directly addresses the observed pipeline symptom.' }));
slides.push(...deepDives);
---
<BaseLayout title="Data Operations and Support Course" activeSlug="courses"><CourseDeck title="Data Operations and Support" weight="Domain 3 · 22%" slides={slides} back={`${base}/courses/dea-c01/`} /></BaseLayout>
