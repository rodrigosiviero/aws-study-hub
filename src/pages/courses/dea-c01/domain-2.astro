---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseDeck from '../../../components/CourseDeck.astro';
const base = import.meta.env.BASE_URL;
const slides = [{"eyebrow": "Course map", "title": "Choose the store from the access pattern", "body": "<div class=\"course-four-grid\"><div><b>OLTP</b><span>Aurora, RDS, DynamoDB</span></div><div><b>OLAP</b><span>Redshift, Athena, S3</span></div><div><b>Search</b><span>OpenSearch</span></div><div><b>Graph/vector</b><span>Neptune, Aurora pgvector</span></div></div><div class=\"course-callout\"><strong>Exam rule:</strong> latency, query pattern, scale, and operations decide the store.</div>", "context": "A store is not selected by data size alone. Start with how the application reads and writes the data."}, {"eyebrow": "Object storage", "title": "S3 is the data lake foundation", "body": "<ul class=\"course-bullets two-up\"><li>Object storage for raw, curated, archive, and shared data.</li><li>11 nines durability; lifecycle policies control cost.</li><li>Partition and use Parquet or ORC to reduce scanned data.</li><li>Use S3 Tables for managed Iceberg tables.</li></ul>", "context": "S3 stores files, not database rows. Query engines use metadata and partitions to read it efficiently."}, {"eyebrow": "Warehouse", "title": "Redshift serves analytical SQL", "body": "<table class=\"course-table\"><tr><th>Need</th><th>Choice</th></tr><tr><td>Steady warehouse</td><td>RA3 cluster</td></tr><tr><td>Variable usage</td><td>Redshift Serverless</td></tr><tr><td>Query S3 in place</td><td>Spectrum</td></tr><tr><td>Fast repeated aggregation</td><td>Materialized view</td></tr></table>", "context": "COPY loads from S3 in parallel; UNLOAD writes results back. Spectrum avoids loading data when S3 is the right location."}, {"eyebrow": "NoSQL", "title": "DynamoDB follows the key design", "body": "<ul class=\"course-bullets two-up\"><li>Single-digit millisecond key-value or document access.</li><li>Partition key distributes data; sort key organizes related items.</li><li>GSI supports alternate query patterns; TTL expires items.</li><li>DAX accelerates reads; Streams expose changes.</li></ul>", "context": "Design queries first. A scan is rarely the intended high-scale answer when a key or index can serve the request."}, {"eyebrow": "Open table formats", "title": "Iceberg brings transactions to the lake", "body": "<ul class=\"course-bullets\"><li>ACID snapshots, time travel, rollback, and schema evolution on S3.</li><li>Hidden partitioning and partition-spec evolution reduce maintenance.</li><li>Athena, Glue, and Redshift can query Iceberg; Lake Formation governs access.</li></ul>", "context": "Iceberg is the exam signal when the lake needs safe concurrent writes, evolving schemas, or time travel."}, {"eyebrow": "Catalogs", "title": "Technical metadata and business context", "body": "<div class=\"course-two-col\"><div class=\"course-card\"><h3>Glue Data Catalog</h3><p>Tables, columns, partitions, locations; used by Athena, Glue, EMR, Spectrum.</p></div><div class=\"course-card\"><h3>SageMaker Catalog</h3><p>Business glossary, ownership, subscriptions, data products, approvals.</p></div></div>", "context": "Glue Catalog answers how engines find data. SageMaker Catalog adds human business context and governed discovery."}, {"eyebrow": "Lifecycle", "title": "Automate cost, retention, and deletion", "body": "<ul class=\"course-bullets two-up\"><li>Lifecycle transitions Standard → IA → Glacier based on age.</li><li>Versioning protects against overwrites; Object Lock is WORM.</li><li>Expiration, noncurrent-version expiration, and multipart cleanup reduce cost.</li><li>Batch Operations supports bulk remediation or deletion.</li></ul>", "context": "Use lifecycle rules for predictable age-based management, not a scheduled Lambda when native S3 controls suffice."}, {"eyebrow": "Resilience", "title": "Match replication to recovery needs", "body": "<div class=\"course-four-grid\"><div><b>S3</b><span>CRR/SRR</span></div><div><b>DynamoDB</b><span>Global tables</span></div><div><b>Aurora</b><span>Global Database</span></div><div><b>Redshift</b><span>Cross-Region snapshots</span></div></div>", "context": "Durability, availability, and regional recovery are separate requirements. Read the stated RPO and active-active requirement."}, {"eyebrow": "Models", "title": "Model for the engine", "body": "<ul class=\"course-bullets two-up\"><li>Redshift: star schema, DISTKEY, SORTKEY, compression, WLM.</li><li>DynamoDB: composite key, GSI/LSI, avoid hot partitions.</li><li>S3: date/category prefixes, avoid small files, use columnar formats.</li><li>Relational: expand-contract schema migrations for compatibility.</li></ul>", "context": "Schema evolution should preserve existing readers: add, backfill, migrate consumers, then remove old fields."}, {"eyebrow": "Vectors", "title": "Choose recall, latency, and memory trade-offs", "body": "<table class=\"course-table\"><tr><th>Index</th><th>Trade-off</th></tr><tr><td>HNSW</td><td>Fast, memory intensive, incremental updates</td></tr><tr><td>IVF</td><td>Clustered, faster but lower recall</td></tr><tr><td>Flat</td><td>Exact recall, expensive search</td></tr></table>", "context": "Embeddings store semantic meaning as vectors. The question may require Aurora pgvector, OpenSearch, or a managed Bedrock Knowledge Base."}, {"eyebrow": "Exam drill", "title": "Domain 2 service-selection checks", "body": "<ol class=\"course-questions\"><li>Need SQL across S3 with no cluster?<details><summary>Answer</summary>Athena with Glue Data Catalog and partitioned Parquet.</details></li><li>Need governed ACID lake tables?<details><summary>Answer</summary>S3 Tables/Iceberg with Lake Formation.</details></li><li>Need sub-10ms keyed reads?<details><summary>Answer</summary>DynamoDB; use DAX when read caching is required.</details></li></ol>", "context": "Practice stating the requirement phrase that eliminates every wrong answer."}, {"eyebrow": "Final review", "title": "Domain 2 readiness checklist", "body": "<ul class=\"checklist\"><li>Map access pattern to store before choosing a database.</li><li>Explain Glue Catalog, crawlers, partitions, and business catalog roles.</li><li>Recognize Iceberg, lifecycle, resiliency, models, and vector trade-offs.</li></ul>", "context": "The correct option meets all requirements with the least unnecessary operational work."}];
const deepDives = [['Migration', 'Transfer Family moves SFTP/FTPS/AS2 data|DataSync accelerates file transfers|DMS full load plus CDC moves databases'], ['Federated query', 'Redshift federated query reads RDS/Aurora|Athena federation uses Lambda connectors|Data sharing exposes live Redshift data with no copy'], ['Concurrency', 'Aurora uses transaction and row locks|DynamoDB uses ConditionExpression optimistic locking|Iceberg uses transactional commits and snapshots'], ['Partition strategy', 'Partition by common date or region filters|Glue partition indexes speed metadata lookups|Avoid high-cardinality partitions and small files'], ['Formats and compression', 'Parquet/ORC are columnar analytical formats|Avro supports row records and schema evolution|Compression reduces scan and storage cost'], ['Lifecycle versus DR', 'Lifecycle reduces cost by age|Versioning and Object Lock protect objects|CRR, global tables, and Aurora Global Database are recovery controls'], ['Physical models', 'Redshift needs DISTKEY, SORTKEY, compression, WLM|DynamoDB needs query-first key and GSI design|Lake tables need file-size and partition strategy'], ['Vector stores', 'HNSW is fast and memory-heavy|IVF trades recall for lower memory|Aurora pgvector, OpenSearch, and Bedrock fit different needs'], ['Exam traps', 'Kafka compatibility means MSK|SQL on S3 means Athena or Spectrum|Business glossary means SageMaker Catalog'], ['Coverage review', 'Choose store, catalog, lifecycle, model, migration, sharing|Explain Iceberg, partitions, schema evolution, and vectors']].map(([title, text]) => ({ eyebrow: 'Deep dive', title, body: '<ul class="course-bullets">' + text.split('|').map(item => '<li>' + item + '</li>').join('') + '</ul>', context: 'Use the stated access pattern, operational boundary, and recovery requirement to eliminate the wrong services.' }));
slides.push(...deepDives);
---
<BaseLayout title="Data Store Management Course" activeSlug="courses"><CourseDeck title="Data Store Management" weight="Domain 2 · 26%" slides={slides} back={`${base}/courses/dea-c01/`} /></BaseLayout>
