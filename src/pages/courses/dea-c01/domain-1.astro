<script>
const slides = Array.from(document.querySelectorAll('.course-slide'));
const counter = document.querySelector('#course-counter');
const progress = document.querySelector('#course-progress-fill');
const courseShell = document.querySelector('.course-shell') as HTMLElement;
const fullscreen = document.querySelector('#course-fullscreen') as HTMLButtonElement;
const previous = document.querySelector('#course-prev') as HTMLButtonElement;
const next = document.querySelector('#course-next') as HTMLButtonElement;
let current = 0;
slides.forEach((slide) => { slide.querySelector(':scope > details')?.setAttribute('open', ''); });
function showSlide(index: number) { current = Math.max(0, Math.min(index, slides.length - 1)); slides.forEach((slide, position) => slide.classList.toggle('is-active', position === current)); counter!.textContent = `Slide ${current + 1} of ${slides.length}`; progress!.style.width = `${((current + 1) / slides.length) * 100}%`; previous.disabled = current === 0; next.disabled = current === slides.length - 1; next.textContent = current === slides.length - 1 ? 'End of course' : 'Next →'; }
previous.addEventListener('click', () => showSlide(current - 1)); next.addEventListener('click', () => showSlide(current + 1)); document.addEventListener('keydown', (event) => { if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) return; if (event.key === 'ArrowLeft') showSlide(current - 1); if (event.key === 'ArrowRight' || event.key === ' ') { event.preventDefault(); showSlide(current + 1); } }); showSlide(0);
fullscreen.addEventListener('click', () => document.fullscreenElement ? document.exitFullscreen() : courseShell.requestFullscreen());
document.addEventListener('fullscreenchange', () => { fullscreen.textContent = document.fullscreenElement ? 'Exit fullscreen' : 'Fullscreen'; });
</script>
