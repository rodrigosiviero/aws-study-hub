---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="DEA-C01 Courses" activeSlug="courses" description="Domain presentations for AWS Certified Data Engineer – Associate.">
  <section class="courses-page">
    <a class="course-back" href={`${base}/courses/`}>← All courses</a>
    <p class="course-kicker">AWS Certified Data Engineer – Associate</p>
    <h1>DEA-C01 presentations</h1>
    <p class="courses-lead">Choose a domain. Each presentation is built for a beginner and follows the DEA-C01 exam guide.</p>
    <div class="course-domain-grid">
      <a class="course-domain-card primary" href={`${base}/courses/dea-c01/domain-1/`}>
        <span>Domain 1 · 34%</span><h2>Data Ingestion and Transformation</h2><p>29 slides · streaming, batch, transformation, orchestration, and programming concepts.</p><strong>Start presentation →</strong>
      </a>
      <a class="course-domain-card" href={`${base}/courses/dea-c01/domain-2/`}><span>Domain 2 · 26%</span><h2>Data Store Management</h2><p>Storage selection, cataloging, lifecycle, Iceberg, modeling, and vector data.</p><strong>Start presentation →</strong></a>
      <a class="course-domain-card" href={`${base}/courses/dea-c01/domain-3/`}><span>Domain 3 · 22%</span><h2>Data Operations and Support</h2><p>Automation, SQL analysis, monitoring, troubleshooting, and data quality.</p><strong>Start presentation →</strong></a>
      <a class="course-domain-card" href={`${base}/courses/dea-c01/domain-4/`}><span>Domain 4 · 18%</span><h2>Data Security and Governance</h2><p>Authentication, authorization, encryption, audit, and governance.</p><strong>Start presentation →</strong></a>
    </div>
  </section>
</BaseLayout>
