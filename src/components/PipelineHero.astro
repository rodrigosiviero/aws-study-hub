---
const stages = [
  { label: 'Learn', color: '#FF9900' },
  { label: 'Practice', color: '#14B8A6' },
  { label: 'Review', color: '#6366F1' },
  { label: 'Certify', color: '#10B981' },
];
---

<section class="hero">
    <p class="hero-eyebrow">AWS Certification Guides</p>
    <h1>Study AWS your way</h1>
    <p class="lead">Condensed content from official exam guides — straight to the point, organized by domain and exam weight.</p>
    <div class="pipeline">
        {stages.map((s, i) => (
            <>
                {i > 0 && <div class="pipeline-connector"></div>}
                <div class="pipeline-node">
                    <div class="dot" style={`background:${s.color}`}></div>
                    <span>{s.label}</span>
                </div>
            </>
        ))}
    </div>
</section>
