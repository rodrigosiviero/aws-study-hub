---
import { getCollection } from 'astro:content';

const certs = (await getCollection('certs')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
---

<div class="cert-grid">
    {certs.map((c) => (
        <a href={`${base}/${c.slug}/`} class="cert-card">
            <span class="code">{c.data.code}</span>
            <span class="name">{c.data.title}</span>
            {c.data.description && <p style="font-size:0.85rem; color:var(--ink-soft); margin-top:0.5rem; margin-bottom:0;">{c.data.description}</p>}
            <span class="status">{c.data.status === 'complete' ? '✅ Full guide' : '🚧 Coming soon'}</span>
        </a>
    ))}
</div>
